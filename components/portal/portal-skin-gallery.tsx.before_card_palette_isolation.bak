"use client";

import { useMemo, useState } from "react";
import type { CSSProperties } from "react";

import { selectPortalSkin } from "@/app/(portal)/appearance/actions";
import { usePortalSkin } from "@/components/portal/portal-skin-provider";

export type AppearanceSkin = {
  id: string;
  slug: string;
  name: string;
  description: string;
  previewImageUrl: string | null;
  pricePence: number | null;
  isDefault: boolean;
  owned: boolean;
  source: "paid" | "staff" | null;
};

type SkinPalette = {
  background: string;
  c1: string;
  c2: string;
};

const SKIN_PALETTES: Record<string, SkinPalette> = {
  sepulchria: {
    background: "#120f0d",
    c1: "rgb(169 138 96)",
    c2: "rgb(211 194 170)",
  },
  vellum: {
    background: "#d9cfb5",
    c1: "rgb(107 35 50)",
    c2: "rgb(23 21 19)",
  },
  starfall: {
    background: "#040816",
    c1: "rgb(127 169 220)",
    c2: "rgb(226 194 125)",
  },
  "rose-nocturne": {
    background: "#12070f",
    c1: "rgb(198 124 105)",
    c2: "rgb(226 179 172)",
  },
  "verdant-reliquary": {
    background: "#040f09",
    c1: "rgb(147 201 136)",
    c2: "rgb(228 219 158)",
  },
  "amethyst-veil": {
    background: "#0d0714",
    c1: "rgb(201 154 76)",
    c2: "rgb(196 174 199)",
  },
  moonlit: {
    background: "#090806",
    c1: "rgb(169 138 96)",
    c2: "rgb(211 194 170)",
  },
  emberforge: {
    background: "#0e0805",
    c1: "rgb(210 123 53)",
    c2: "rgb(239 196 142)",
  },
  deepwater: {
    background: "#031012",
    c1: "rgb(239 182 127)",
    c2: "rgb(215 238 229)",
  },
  "blood-court": {
    background: "#120407",
    c1: "rgb(216 136 136)",
    c2: "rgb(187 199 208)",
  },
  ashen: {
    background: "#c2d6e1",
    c1: "rgb(23 75 56)",
    c2: "rgb(24 47 56)",
  },
  "birdfolks-sky": {
    background: "#c2d6e1",
    c1: "rgb(23 75 56)",
    c2: "rgb(24 47 56)",
  },
  "ivory-archive": {
    background: "#0b0c0d",
    c1: "rgb(169 183 194)",
    c2: "rgb(238 231 220)",
  },
  "aelari-dawn": {
    background: "#d7dcc3",
    c1: "rgb(141 39 28)",
    c2: "rgb(154 67 28)",
  },
  "dwarven-deep": {
    background: "#c1b197",
    c1: "rgb(91 56 35)",
    c2: "rgb(21 19 17)",
  },
  "mortal-hearth": {
    background: "#c3c4bd",
    c1: "rgb(86 54 39)",
    c2: "rgb(23 24 25)",
  },
  "wolfs-moon": {
    background: "#c4cdd0",
    c1: "rgb(217 189 120)",
    c2: "rgb(199 217 227)",
  },
};

const FALLBACK_PALETTE: SkinPalette = {
  background: "#120f0d",
  c1: "rgb(169 138 96)",
  c2: "rgb(211 194 170)",
};

function getPalette(slug: string): SkinPalette {
  return SKIN_PALETTES[slug] ?? FALLBACK_PALETTE;
}

function withAlpha(colour: string, alpha: number): string {
  const rgb = colour.match(
    /^rgb\(\s*(\d+)\s+(\d+)\s+(\d+)\s*\)$/,
  );

  if (!rgb) {
    return colour;
  }

  return `rgb(${rgb[1]} ${rgb[2]} ${rgb[3]} / ${alpha})`;
}

function swatchGradient(palette: SkinPalette): string {
  return `conic-gradient(
    from -90deg,
    ${palette.background} 0deg 120deg,
    ${palette.c1} 120deg 240deg,
    ${palette.c2} 240deg 360deg
  )`;
}

function priceLabel(skin: AppearanceSkin) {
  if (skin.isDefault) {
    return "Included";
  }

  if (typeof skin.pricePence === "number") {
    return new Intl.NumberFormat("en-GB", {
      style: "currency",
      currency: "GBP",
    }).format(skin.pricePence / 100);
  }

  return "Premium";
}

function statusLabel(
  entry: AppearanceSkin,
  current: boolean,
  unlocked: boolean,
): string {
  if (current) {
    return "Current";
  }

  if (!unlocked) {
    return priceLabel(entry);
  }

  if (entry.source === "paid") {
    return "Purchased";
  }

  if (entry.source === "staff") {
    return "Granted";
  }

  return "Owned";
}

function paletteVars(palette: SkinPalette): CSSProperties {
  return {
    "--preview-bg": palette.background,
    "--preview-c1": palette.c1,
    "--preview-c2": palette.c2,
    "--preview-c1-soft": withAlpha(palette.c1, 0.48),
    "--preview-c1-faint": withAlpha(palette.c1, 0.28),
    "--preview-c2-soft": withAlpha(palette.c2, 0.72),
  } as CSSProperties;
}

export function PortalSkinGallery({
  skins,
}: {
  skins: AppearanceSkin[];
}) {
  const {
    skin,
    selectedSkin,
    commitSkin,
    previewSkin,
    endPreview,
  } = usePortalSkin();

  const [workingSlug, setWorkingSlug] =
    useState<string | null>(null);

  const [error, setError] =
    useState<string | null>(null);

  const selectedSkinEntry = useMemo(
    () =>
      skins.find(
        (entry) =>
          entry.slug === selectedSkin,
      ) ?? null,
    [skins, selectedSkin],
  );

  const selectedPalette =
    getPalette(selectedSkin);

  const isPreviewing =
    skin !== selectedSkin;

  async function useSkin(
    target: AppearanceSkin,
  ) {
    if (
      !target.owned &&
      !target.isDefault
    ) {
      return;
    }

    setWorkingSlug(target.slug);
    setError(null);

    const result =
      await selectPortalSkin(
        target.slug,
      );

    setWorkingSlug(null);

    if (!result.ok) {
      setError(
        result.error ??
          "Unable to select skin.",
      );
      return;
    }

    commitSkin(target.slug);
  }

  return (
    <div>
      {error ? (
        <div className="mb-4 border border-red-800/55 bg-red-950/30 px-4 py-3 text-xs text-red-300">
          {error}
        </div>
      ) : null}

      <div className="mb-4 flex items-center justify-between gap-4 border border-[rgb(var(--sep-colour-60482e))]/45 bg-[rgb(var(--sep-colour-15100d))] px-4 py-3">
        <div>
          <p className="text-[8px] uppercase tracking-[0.2em] text-[rgb(var(--sep-colour-806f59))]">
            Selected skin
          </p>

          <p className="mt-1 font-serif text-lg text-[rgb(var(--sep-colour-e1c89f))]">
            {selectedSkinEntry?.name ??
              selectedSkin}
          </p>
        </div>

        <div
          className="h-11 w-11 shrink-0 rounded-full"
          style={{
            background:
              swatchGradient(
                selectedPalette,
              ),
            border: `1px solid ${withAlpha(
              selectedPalette.c1,
              0.6,
            )}`,
            boxShadow:
              "0 0 0 2px rgb(13 10 8)",
          }}
          title={`${
            selectedSkinEntry?.name ??
            selectedSkin
          }: background, C1 and C2 colours`}
          aria-label={`${
            selectedSkinEntry?.name ??
            selectedSkin
          } colour swatch`}
        />
      </div>

      {isPreviewing ? (
        <div className="mb-4 flex flex-wrap items-center justify-between gap-3 border border-[rgb(var(--sep-colour-60482e))]/45 bg-[rgb(var(--sep-colour-15100d))] px-4 py-3">
          <p className="text-xs text-[rgb(var(--sep-colour-baa78c))]">
            Previewing{" "}
            <strong>
              {skin}
            </strong>
            .
          </p>

          <button
            type="button"
            onClick={endPreview}
            className="border border-[rgb(var(--sep-colour-765735))] bg-[rgb(var(--sep-colour-21170f))] px-3 py-2 text-[8px] uppercase tracking-[0.15em] text-[rgb(var(--sep-colour-dfc79c))]"
          >
            End preview
          </button>
        </div>
      ) : null}

      <div className="grid gap-4 lg:grid-cols-2">
        {skins.map((entry) => {
          const current =
            selectedSkin === entry.slug;

          const unlocked =
            entry.isDefault ||
            entry.owned;

          const palette =
            getPalette(entry.slug);

          const vars =
            paletteVars(palette);

          return (
            <article
              key={entry.id}
              className="flex h-full min-h-[200px] flex-col overflow-hidden"
              style={{
                ...vars,
                backgroundColor:
                  "var(--preview-bg)",
                border:
                  "1px solid var(--preview-c1-soft)",
                color:
                  "var(--preview-c2)",
              }}
            >
              <div className="flex h-full flex-col p-5">
                <div className="flex items-start justify-between gap-4">
                  <div className="min-w-0 flex-1">
                    <h2
                      className="text-xl"
                      style={{
                        color:
                          "var(--preview-c1)",
                        fontFamily:
                          "var(--portal-font-display)",
                      }}
                    >
                      {entry.name}
                    </h2>

                    <p
                      className="mt-2 text-[11px] leading-5"
                      style={{
                        color:
                          "var(--preview-c2)",
                        fontFamily:
                          "var(--portal-font-body)",
                      }}
                    >
                      {entry.description}
                    </p>
                  </div>

                  <span
                    className="shrink-0 px-2 py-1 text-[7px] uppercase tracking-[0.15em]"
                    style={{
                      border:
                        "1px solid var(--preview-c1-soft)",
                      color:
                        "var(--preview-c1)",
                      backgroundColor:
                        "transparent",
                      fontFamily:
                        "var(--portal-font-body)",
                    }}
                  >
                    {statusLabel(
                      entry,
                      current,
                      unlocked,
                    )}
                  </span>
                </div>

                {!unlocked ? (
                  <p
                    className="mt-4 pt-3 text-[9px] leading-4"
                    style={{
                      borderTop:
                        "1px solid var(--preview-c1-faint)",
                      color:
                        "var(--preview-c2)",
                      fontFamily:
                        "var(--portal-font-body)",
                    }}
                  >
                    Premium skins are unlocked
                    after a real-money purchase
                    is confirmed by staff, or may
                    be granted directly by staff.
                  </p>
                ) : null}

                <div
                  className="mt-auto flex flex-wrap items-end justify-between gap-3 pt-4"
                  style={{
                    borderTop:
                      "1px solid var(--preview-c1-faint)",
                  }}
                >
                  <div
                    className="h-10 w-10 shrink-0 rounded-full"
                    style={{
                      background:
                        swatchGradient(
                          palette,
                        ),
                      border:
                        "1px solid var(--preview-c1-soft)",
                      boxShadow:
                        "0 0 0 2px rgb(13 10 8)",
                    }}
                    title={`${entry.name}: background, C1 and C2 colours`}
                    aria-label={`${entry.name} colour swatch`}
                  />

                  <div className="flex flex-wrap justify-end gap-2">
                    <button
                      type="button"
                      onClick={() =>
                        previewSkin(
                          entry.slug,
                        )
                      }
                      className="px-3 py-2 text-[8px] uppercase tracking-[0.15em] transition"
                      style={{
                        border:
                          "1px solid var(--preview-c1-soft)",
                        color:
                          "var(--preview-c1)",
                        backgroundColor:
                          "transparent",
                        fontFamily:
                          "var(--portal-font-body)",
                      }}
                    >
                      Preview
                    </button>

                    {unlocked &&
                    !current ? (
                      <button
                        type="button"
                        disabled={
                          workingSlug ===
                          entry.slug
                        }
                        onClick={() =>
                          void useSkin(
                            entry,
                          )
                        }
                        className="px-3 py-2 text-[8px] uppercase tracking-[0.15em] transition disabled:opacity-50"
                        style={{
                          border:
                            "1px solid var(--preview-c1-soft)",
                          color:
                            "var(--preview-c1)",
                          backgroundColor:
                            withAlpha(
                              palette.c1,
                              0.08,
                            ),
                          fontFamily:
                            "var(--portal-font-body)",
                        }}
                      >
                        {workingSlug ===
                        entry.slug
                          ? "Saving..."
                          : "Use skin"}
                      </button>
                    ) : null}
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  );
}
